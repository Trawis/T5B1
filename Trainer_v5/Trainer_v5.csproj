<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net46</TargetFramework>
		<RootNamespace>Trainer_v5</RootNamespace>
		<AssemblyName>Trainer_v5</AssemblyName>
		<LangVersion>6.0</LangVersion>
		<ProjectGuid>{5BF62D82-5C9D-4E95-9835-169756BD58FA}</ProjectGuid>
		<Prefer32Bit>false</Prefer32Bit>
	</PropertyGroup>

	<!--
		Game-version configuration matrix (see Helpers.GetGameVersion and
		docs/project/architecture.md for the full rationale):

		- Debug / Release: the actively maintained Software Inc Beta 1 target
		  (currently 1.7), so the plain configurations that CI and the
		  release/nightly workflows build always include the trainer's full
		  current feature set (e.g. Max Market Share) instead of silently
		  compiling it out.
		- SWINCBETA1_7: explicit debug build pinned to Beta 1.7, kept for
		  developers who want to build against that specific sub-version by
		  name.
		- SWINCBETA / SWINCRELEASE (no sub-version symbol): generic
		  channel-only builds with no specific point version pinned; reporting
		  "UNKNOWN" from Helpers.GetGameVersion for these is intentional.
	-->
	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
		<Optimize>false</Optimize>
		<DefineConstants>DEBUG;TRACE;SWINCBETA;SWINCBETA1_7</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
		<DebugType>pdbonly</DebugType>
		<Optimize>true</Optimize>
		<DefineConstants>TRACE;SWINCBETA;SWINCBETA1_7</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'SWINCBETA1_7|AnyCPU'">
		<DebugSymbols>true</DebugSymbols>
		<DefineConstants>DEBUG;TRACE;SWINCBETA;SWINCBETA1_7</DefineConstants>
		<DebugType>full</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'SWINCBETA|AnyCPU'">
		<DebugSymbols>true</DebugSymbols>
		<DefineConstants>DEBUG;TRACE;SWINCBETA</DefineConstants>
		<DebugType>full</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'SWINCRELEASE|AnyCPU'">
		<DebugType>pdbonly</DebugType>
		<Optimize>true</Optimize>
		<DefineConstants>TRACE;SWINCRELEASE</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
